// Writes src/design-system/theme.ts → src/app/theme.css so Tailwind can compile it.
import { writeFileSync } from "node:fs";
import { tailwindTheme } from "../src/design-system/theme.ts";

const out = new URL("../src/app/theme.css", import.meta.url);
writeFileSync(out, `/* Generated by scripts/write-theme.mts from src/design-system/theme.ts — do not edit. */\n\n${tailwindTheme}`);
console.log("wrote src/app/theme.css");
